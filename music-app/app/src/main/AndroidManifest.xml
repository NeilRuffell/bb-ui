<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Media3's background audio session; no general storage permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Music is read only from user-selected SAF document trees. -->
    <!-- Narrow package visibility; no QUERY_ALL_PACKAGES or privileged access. -->
    <queries>
        <package android:name="app.symfonik.music.player" />
    </queries>
    <application
        android:label="BB Music"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service
            android:name=".MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <activity
            android:name=".MusicActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
