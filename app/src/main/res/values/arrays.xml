        <item>com.android.settings</item>
        <item>com.android.settings.intelligence</item>
        <item>com.android.systemui</item>
        <item>com.android.launcher3</item>
        <item>com.android.permissioncontroller</item>
        <item>com.google.android.permissioncontroller</item>
        <item>com.android.documentsui</item>
        <item>com.android.packageinstaller</item>
        <item>com.google.android.packageinstaller</item>
        <item>com.android.contacts</item>
        <item>com.android.dialer</item>
        <item>org.lineageos.settings</item>
    </string-array>
</resources>
