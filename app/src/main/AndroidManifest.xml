<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.android.systemui" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="BB UI" android:description="@string/module_description" android:hasCode="true">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Unified BlackBerry UI: Settings, focus styling, status-bar navigation, notifications and Quickstep Recents" />
        <meta-data android:name="xposedminversion" android:value="82" />

        <activity android:name="dev.q25.bb7pulldown.FavoritesSettingsActivity"
            android:label="BB UI Favorites" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider android:name="dev.q25.bb7pulldown.FavoritesSettingsProvider"
            android:authorities="dev.q25.trackpad.favorites"
            android:exported="true" />
    </application>
</manifest>
